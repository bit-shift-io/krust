{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "compaction": {
    "auto": true,
    "threshold": 0.65
  },
  "provider": {
    "options": {
      "timeout": 300000,
      "chunkTimeout": 10000,
      "keepAlive": true,
      "keepAliveMsecs": 5000
    }
  },
  "plugin": [
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz",
    "./plugins/network-watchdog.js"
  ],
  "permission": {
    "todowrite": "allow",
    "skill": {
      "*": "allow"
    },
    "read": {
      "*": "allow",
      "~/.cargo": "allow",
      "~/.cargo/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/var/tmp": "allow",
      "/var/tmp/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/.cargo": "allow",
      "~/.cargo/**": "allow",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/var/tmp": "allow",
      "/var/tmp/**": "allow"
    },
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny"
    }
  }
}
